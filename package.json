{
  "name": "gicc-website",
  "version": "1.0.0",
  "private": true,
  "description": "Guildford Islamic Cultural Center website.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "cf:dev": "wrangler pages dev out",
    "cf:types": "wrangler types cloudflare-env.d.ts --include-runtime=false",
    "check": "npm run lint && npm run typecheck && npm run build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc -p functions/tsconfig.json --noEmit"
  },
  "dependencies": {
    "ical.js": "^2.2.1",
    "lucide-react": "1.17.0",
    "next": "16.4.2",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^22.19.9",
    "@types/react": "^19.2.9",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.1",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "wrangler": "^4.110.0"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "postcss": "8.5.31"
  }
}
